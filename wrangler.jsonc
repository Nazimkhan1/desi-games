{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desi-games",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "desi-games.nextgrade.in",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}